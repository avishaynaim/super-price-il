[Unit]
Description=super-price-il daily price ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Edit WorkingDirectory to match where the repo lives on the host.
WorkingDirectory=/opt/super-price-il
ExecStart=/opt/super-price-il/scripts/daily_backfill.sh
# Give HTTP listings + large gzip parses room; tune if needed.
TimeoutStartSec=3600
Nice=10
# Install requirements once via pip; no venv assumed for a single-purpose host.
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
# Run unprivileged: this job parses untrusted retailer files.
# Create the account once, e.g.: useradd --system --home /opt/super-price-il --shell /usr/sbin/nologin superprice
# and make the repo (data/, raw/) writable by it: chown -R superprice: /opt/super-price-il/data /opt/super-price-il/raw
User=superprice
Group=superprice
# Sandboxing. The repo dir stays writable for data/ (SQLite, settings) and raw/.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/super-price-il
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
